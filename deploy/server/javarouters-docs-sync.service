[Unit]
Description=Pull the latest JavaRouters docs build from the deploy branch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
ExecStart=/bin/sh /opt/javarouters/docs-sync.sh
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/javarouters/docs-site
